# Copy to .env and fill in. All EXPO_PUBLIC_* values are embedded in the client bundle.

# RevenueCat public SDK keys (Project settings → API keys). Leave blank to use the mock store.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# Entitlement identifier configured in RevenueCat (default: pro)
EXPO_PUBLIC_RC_ENTITLEMENT=pro

# Mixpanel project token. Leave blank to log events to the console in dev.
EXPO_PUBLIC_MIXPANEL_TOKEN=

# Remote catalog feed (JSON array of Opportunity, same shape as src/content/catalog.json).
# Leave blank to use only the bundled seed.
EXPO_PUBLIC_CATALOG_URL=

# Where "Report a wrong deadline or amount" emails go.
EXPO_PUBLIC_SUPPORT_EMAIL=
